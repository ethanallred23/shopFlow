{
    admin 127.0.0.1:2019
    auto_https disable_redirects
    skip_install_trust
    storage file_system {
        root "{$SHOPFLOW_TLS_DATA}"
    }
    servers {
        protocols h1 h2
    }
}

# Private LAN IP only. IT must reserve this address before physical deployment.
https://192.168.10.36 {
    bind 192.168.10.36
    tls internal
    @deviceApi {
        method POST
        path /api/v1/events /api/v1/heartbeat
    }
    handle @deviceApi {
        reverse_proxy 127.0.0.1:3001
    }
    handle {
        respond "ShopFlow device API only" 404
    }
}
