{
  "name": "shopflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "prisma generate && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:check": "tsx scripts/check-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "demo:biltoki": "tsx scripts/seed-biltoki-example.ts",
    "rebuild": "tsx server/rebuild.ts",
    "simulate": "tsx scripts/simulator.ts",
    "db:setup": "tsx scripts/create-admin.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "setup:production": "tsx scripts/setup-production.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "luxon": "3.7.2",
    "pino": "9.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.23",
    "@types/luxon": "3.7.1",
    "@types/node": "22.18.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.5",
    "postcss": "8.5.30",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.4",
    "vitest": "^5.0.4"
  }
}
