DATABASE_URL=mysql://shopflow:local-only-password@localhost:3306/shopflow
PORT=3001
# Keep loopback when using a same-host HTTPS reverse proxy.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SEED_EMAIL=admin@shopflow.local
SEED_PASSWORD=change-this-before-use
# Set RUN_DB_TESTS=1 only with a disposable migrated MySQL database.
RUN_DB_TESTS=0
