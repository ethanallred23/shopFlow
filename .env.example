# Insert URL-encoded username between // and :, and password between : and @.
# Blank fields are placeholders, not an empty-password MySQL configuration.
DATABASE_URL=mysql://:@127.0.0.1:3307/shopflow
# Optional Docker Compose setup only; existing portable MySQL does not use these.
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
PORT=3001
# Keep loopback when using a same-host HTTPS reverse proxy.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Local demo database only: animate three simulated cabinet workstations with npm run dev.
LOCAL_CABINET_SIMULATION=0
# Development demo seeding only. Production uses npm run admin:create prompts.
SEED_EMAIL=admin@shopflow.local
SEED_PASSWORD=change-this-before-use
# Set RUN_DB_TESTS=1 only with a disposable migrated MySQL database.
RUN_DB_TESTS=0
